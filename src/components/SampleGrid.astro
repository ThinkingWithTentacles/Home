---
import SampleViewer from './SampleViewer.astro';

const { samples } = Astro.props;
---

<section class="sample-grid">
  {samples.map((sample) => (
    <SampleViewer sample={sample} />
  ))}
</section>

<script>
  const background = document.getElementById('background');
  const sign = document.querySelector('.woodcraft-sign')
  const sampleGrids = document.querySelectorAll('.sample-grid');

  if (background) {
    const wallpaper = background.style.backgroundImage;
    const text = sign.style.backgroundImage;
    let lastTest = text;

    sampleGrids.forEach(grid => {
      grid.addEventListener('click', (event) => {
        const button = event.target.closest('[data-action="background"]');

        if (!button) return;

        const sample = button.dataset.background;

        if (button.classList.contains('selected')) {
          background.style.backgroundImage = wallpaper;
          sign.style.backgroundImage = lastTest;
          button.classList.remove('selected');
          return;
        }

        background.style.backgroundImage = `url('${sample}')`;
        sign.style.backgroundImage = wallpaper;

        document
          .querySelectorAll('[data-action="background"]')
          .forEach(sample => {
            sample.classList.remove('selected');
          });

        button.classList.add('selected');

        lastTest = `url('${sample}')`;
      });
    });
  }
</script>