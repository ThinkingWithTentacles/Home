<style>
    .contact-form {
    position: relative;
    width: 100%;
    max-width: 90dvw;
    height: auto;
    left: 2.5dvw;

    padding: 2.5rem;

    box-sizing: border-box;

    display: block;
    align-self: center;
    }

    .contact-label {
    width: 100%;
    margin-bottom: 0.5rem;
    color: white;
    display: block;
    }

    .contact-form input,
    .contact-form textarea {
    width: 100%; 
    margin-bottom: 1.5rem;
    padding: 0.75rem;
    box-sizing: border-box;
    border: 1px solid #ccc;
    border-radius: 4px;
    }

    .contact-form button {
    width: 100%;
    padding: 0.75rem;
    cursor: pointer;
    }
</style>


<form action="https://formspree.io/f/xgaejpld" method="POST" class="contact-form">
    <label for="email" class="contact-label">Email</label>
    <input
        type="email"
        id="email"
        name="email"
        placeholder="How can I reach you?"
        required
    />

    <label for="message" class="contact-label">Message</label>
    <textarea
        id="message"
        name="message"
        rows="8"
        placeholder="What can I make for you?"
        required
    ></textarea>

    <button type="SUBMIT">Submit</button>
</form>