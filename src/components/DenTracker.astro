<script>
    const plates = document.querySelectorAll('.dead-halo-plate');

    plates.forEach((plate) => {
    let currentValue = Math.floor(Math.random() * 200) - 100;
    let direction = Math.random() > 0.5 ? 1 : -1;
    
    const speedPerSecond = 10; 
    
    let lastTime = performance.now();

    function updateMovement(currentTime) {
        const deltaTime = (currentTime - lastTime) / 1000;
        lastTime = currentTime;

        if (deltaTime < 0.1) {
        currentValue += speedPerSecond * direction * deltaTime;
        }

        if (currentValue >= 80) {
        currentValue = 80;
        direction = -1;
        } else if (currentValue <= -80) {
        currentValue = -80;
        direction = 1;
        }

        plate.style.setProperty('--shadow-x', `${currentValue}dvw`);

        requestAnimationFrame(updateMovement);
    }

    requestAnimationFrame(updateMovement);
    });
</script>