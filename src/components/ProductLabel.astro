---
    const { text } = Astro.props;
    const { location } = Astro.props;

    let className = "";

    if(location == "swamp") {
        className = "swamp-product-label";
    }
    else if(location == "garden") {
        className = "garden-product-label";
    }
    else {
        className = "page-product-label";
    }
---

<section class={className}>
    <h1> {text} </h1>
</section>