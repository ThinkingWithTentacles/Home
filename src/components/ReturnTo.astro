---
import { Image } from 'astro:assets';
import { pages } from '/src/data/resource.ts';

import {
  index, 
  swampGrove, 
  wickedGrove,
} from '../config.js';

let returnIcon = "";
let address = ""; 

const { destination } = Astro.props;

if(destination == "garden") {
    returnIcon = pages.wicked.sunsoul;
    address = wickedGrove;
}

else if(destination == "swamp") {
    returnIcon = pages.swamp.thinking;
    address = swampGrove;
}

else if(destination == "home") {
    returnIcon = pages.home.banner;
    address = "/";
}
---

<style>
  .return-link {
    position: fixed;
    width: 15dvw;
    height: 15dvw;
    max-width: 80px;
    max-height: 80px;
    top: 15px;
    left: 15px;

    aspect-ratio: 1;
    border-radius: .5rem;

    overflow: hidden;
    display: block; 

    z-index: 9999;
  }

  @media (pointer: fine) {
    .return-link {
      max-width: 90px;
      max-height: 90px;
    }
  }

  .return-image {
    display: block;

    width: 100%;
    height: 100%;
  }
</style>

<nav class="return-link">
  <a href={address} rel="noopener noreferrer">
    <Image src={returnIcon} alt="Link Tree" class="return-image" />
  </a>
</nav>