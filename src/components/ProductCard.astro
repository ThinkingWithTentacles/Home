---
import { fluffTitle } from '/src/utils/helper.ts';
import { fluffWord } from '/src/utils/helper.ts';

import ProductViewer from './ProductViewer.astro';

const { product } = Astro.props;

const formatter = new Intl.ListFormat('en', { style: 'long', type: 'conjunction' , });

const brandName = product.ingredients?.[0] ? 
  fluffTitle(product.ingredients[0], product.style, product.flavor, product.flavor === 'tarot card') 
  : fluffTitle(product.style, product.subject? product.subject : product.size, product.flavor, product.flavor === 'tarot card');

const newFlavor = product.ingredients?.[0] ? 
`Featuring a ${product.style} style design` : product.style ? 
`${fluffWord(product.style)} style design` : '';

const cherryGarnish = product.ingredients?.[0] ? 'Made from ' + formatter.format(product.ingredients) : product.subject? 'Made with wood, hot metal, and burning love' : 'Made with Dharma iced die technique';
const flavorSize = product.size ? `Size: ${product.size}` : ''

const candyPrice = product.value ? "$" + product.value : "Concept";

const lightboxData = { 
  brand: `${brandName}`,
  flavor: `${newFlavor}`, 
  ingredients: `${cherryGarnish}`, 
  size: `${flavorSize}`
};
---

<section class="product-card" data-deep-info={JSON.stringify(lightboxData)}> 
  <ProductViewer product={product} />

  <section class="product-info --standard">
    <h3>{brandName}</h3>
    <p>{candyPrice}</p>
  </section>
</section>