---
import { fluffTitle } from '/src/utils/helper.ts';
import { fluffFlavor } from '/src/utils/helper.ts';
import { fluffIngredients} from '/src/utils/helper.ts';
import { fluffSize } from '/src/utils/helper.ts';
import { fluffValue } from '/src/utils/helper.ts';
import { fluffWord } from '/src/utils/helper.ts';

import ProductViewer from './ProductViewer.astro';

const { product } = Astro.props;

const formatter = new Intl.ListFormat('en', { style: 'long', type: 'conjunction' , });

const brandName = fluffTitle(product);
const newFlavor = fluffFlavor(product);
const cherryGarnish = fluffIngredients(product);
const flavorSize = fluffSize(product);
const candyPrice = fluffValue(product);

const lightboxData = { 
  brand: `${brandName}`,
  flavor: `${newFlavor}`, 
  ingredients: `${cherryGarnish}`, 
  size: `${flavorSize}`
};
---

<section class="product-card" data-deep-info={JSON.stringify(lightboxData)}> 
  <ProductViewer product={product} />

  <section class="product-info --standard">
    <h3>{brandName}</h3>
    <h4>{candyPrice}</h4>
  </section>
</section>