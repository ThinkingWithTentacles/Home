---
import { Image } from 'astro:assets';

const { sample } = Astro.props;
---

<button class="sample-wrapper" data-action="background" data-background={sample.src}>
    <Image src={sample} alt="Sample"/>
    <span class="sample-name">
        {sample.src.split('/').pop().split('.')[1]}
    </span>
</button>