---
import { Image } from 'astro:assets';
import { icons } from '/src/data/resource.ts';

const swampLinks = [
  { href: "https://linktr.ee/ThinkingWithTentacles", src: icons.social.tree, alt: "Link Tree" },
  { href: "https://cash.app/$elara", src: icons.social.cash, alt: "Link Tree" },
  { href: "https://www.etsy.com/shop/ThinkinWithTentacles", src: icons.social.etsy, alt: "Etsy" },
  { href: "https://www.youtube.com/@TentacularQueen", src: icons.social.youtube, alt: "YouTube" },
  { href: "https://www.tiktok.com/@thinkingwithtentacles", src: icons.social.tiktok, alt: "TikTok" },
  { href: "https://www.twitch.tv/thinkingwithtentacles", src: icons.social.twitch, alt: "Twitch" }
];

const wickedLinks = [
  { href: "https://linktr.ee/wickedgabi", src: icons.social.tree, alt: "Link Tree" },
  { href: "https://www.etsy.com/shop/TheSunSoul?etsrc=sdt", src: icons.social.etsy, alt: "Etsy" },
  { href: "https://cash.app/$wickedgabi", src: icons.social.cash, alt: "Link Tree" },
  { href: "https://www.tiktok.com/@wickedgabi", src: icons.social.tiktok, alt: "Etsy" }
];

const { source } = Astro.props;
---

<style>
.social-grid {
  position: relative;
  width: 100dww;
  display: flex;
  justify-content: center;
}

.social-links {
  position: relative;
  margin-top: 10dvh;
  margin-bottom: 10dvh;
  width: 90%;
  max-width: 1080px;
  left: .5%;

  display: grid;
  grid-template-columns: repeat(auto-fit, 45px);
  justify-content: center;
}

@media (pointer: fine) {
  .social-links {
    grid-template-columns: repeat(auto-fit, 65px);
  }
}

.social-image {
  width: 10cqi;
  height: 10cqi;
  object-fit: contain;
}

@media (hover: hover) and (pointer: fine) {
  .social-image {
    width: 5cqi;
    height: 5cqi;
  }
}
</style>

<section class="social-grid">
   {source === "swamp" &&
    <nav class="social-links">
      {swampLinks.map((link) => (
        <a href={link.href} target="_blank" rel="noopener noreferrer">
          <Image src={link.src} alt={link.alt} class="social-image" />
        </a>
      ))}
    </nav>
  }

  {source === "garden" &&
    <nav class="social-links">
      {wickedLinks.map((link) => (
        <a href={link.href} target="_blank" rel="noopener noreferrer">
          <Image src={link.src} alt={link.alt} class="social-image" />
        </a>
      ))}
    </nav>
  }
</section>