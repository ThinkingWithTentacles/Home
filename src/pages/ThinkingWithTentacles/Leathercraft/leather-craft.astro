---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

import { wallpapers } from '/src/data/resource.ts';
import { swampLeathercraft } from '/src/data/swamp.ts';
import { swampLeather } from '/src/data/swamp.ts';

import SampleGrid from '/src/components/SampleGrid.astro';
import ProductGrid from '/src/components/ProductGrid.astro';
import LightBox from '/src/components/LightBox.astro';
import ContactForm from '/src/components/ContactForm.astro';
import SocialLinks from '/src/components/WickedSocialLinks.astro';

import '/src/styles/global.css';
import '/src/styles/leathercraft-page.css';

const wallpaper = wallpapers.woodcraft[2];
---

<body
  id="background"
  class="product-page-background"
  style={`background-image: url(${wallpaper.image.src})`}
>

<main>
    <section class="leathercraft-sign">
      <h1>Leathercraft</h1>
    </section>

    <section class="leathercraft-info">
      <h1>Coming Soon</h1>
    </section>
  </main>
</body> 