---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

import { wallpapers } from '/src/data/wallpaper.ts';
import { swampWoodcraft } from '/src/data/swamp.ts';
import { swampWood } from '/src/data/swamp.ts';

import '/src/styles/global.css';
import '/src/styles/woodcraft-page.css';

const wallpaper = wallpapers.woodcraft[2];

const samples = swampWoodcraft.sample;
const rawSamples = samples.slice(0, 10);
const marinatedSamples = samples.slice(10);
const tameWood = swampWood.tame;
const spicyWood = swampWood.spicy;
const hotWood = swampWood.hot;

const formatter = new Intl.ListFormat('en', { style: 'long', type: 'conjunction' , });
---

<body id = "background"; class= "product-page-background" style={`background-image: url(${wallpaper.image.src})`}>
  <main>
    <section id="woodcraft" class="woodcraft-sign">
      <h1>Woodcraft</h1>
    </section>

    <section class="sample-grid">
      {rawSamples.map((sample) => (
        <button class="sample-wrapper" data-action="background" data-background={sample.image.src}>
          <Image src={sample.image} alt="Sample"/>
          <span class="sample-name">{sample.name}</span>
        </button>
      ))}
    </section>

    <section class="sample-grid">
      {marinatedSamples.map((sample) => (
        <button class="sample-wrapper" data-action="background" data-background={sample.image.src}>
          <Image src={sample.image} alt="Sample"/>
          <span class="sample-name">{sample.name}</span>
        </button>
      ))}
    </section>

    <section class="woodcraft-info">
      <h1>WOOD!</h1>

      <p>Ash, White Maple, Cherry, Mahagony, Walnut, Black Limba, Canary, Yellowheart, Padauk, Purpleheart </p>
      
      <p> Here we talk about the thing that the page represents and the arts and crafts involved with 
      it on a hand loved personal level. And all it takes it writing it out, all of it, eventually, 
      when the words themselves look pretty enough on the page and items fall from the sky when those 
      landmine links go "off" </p>
    </section>

<article class="product-grid"> 
  {Object.values(spicyWood).flatMap((flavors) => {
    return Object.values(flavors).map((order) => {
      // Get the keys available for this order (e.g. "F,B,L")
      const availableKeys = Object.keys(order.shots).join(',');

      {console.log(order.shots)}

      return (
        <article class="product-card" data-available-keys={availableKeys}>
          <div class="product-wrapper" data-action="enhance"> 
            <Image class="shot" src={order.flagShot} alt="Wood" data-key="F" />
            
            <section class="description product-info-deep"> 
              <p>Crafted out of {formatter.format(order.ingredients).toLowerCase()} hardwood</p> 
              <p>Custom {order.style.toLowerCase()} style</p> 
              <p>{order.flavor} design</p> 
              <p>Good thud, Good chud</p> 
            </section> 
          </div>

          <button class="product-swipe-left" data-action="flip-left"></button>
          <button class="product-swipe-right" data-action="flip-right"></button>
          
          <button class="product-info" data-action="dive"> 
            <h3>{order.ingredients[0]} {order.style} {order.flavor}</h3> 
            <p>${order.value}</p> 
          </button>
        </article>
      )
    });
  })}
</article>
  </main>
</body> 

<script>
  const buttons = document.querySelectorAll('[data-action="background"]');

  const background = document.getElementById('background');
  const wallpaper = background.style.backgroundImage;

  buttons.forEach(button => {
    button.addEventListener('click', () => {
      const sample = button.dataset.background;

      if (button.classList.contains('selected')) {
        background.style.backgroundImage = wallpaper;
        button.classList.remove('selected');
      } else {
        background.style.backgroundImage = `url('${sample}')`;

        buttons.forEach(sample => {
          sample.classList.remove('selected');
        });

        button.classList.add('selected');
      }
    });
  });
</script>

<script>
  const buttons = document.querySelectorAll('[data-action="enhance"]');

  buttons.forEach(button => {
    button.addEventListener('click', () => {
    button.classList.toggle('enhanced');
    });
  });
</script>

<script>
  const buttons = document.querySelectorAll('[data-action="dive"]');
  
  buttons.forEach(button => {
    button.addEventListener('click', () => {
      const deepInfo = button.closest('.product-card'); 
      const description = deepInfo?.querySelector('.description');
      
      if (description) {
        description.classList.toggle('dive');
      }
    });
  });
</script>

<script>
  // 1. Eagerly load all optimized image asset URLs within your assets folder
  const allOptimizedImages = import.meta.glob('/src/assets/**/*', { eager: true, import: 'default' });

  const flipButtons = document.querySelectorAll('[data-action="flip-left"], [data-action="flip-right"]');  
  
  flipButtons.forEach(button => {
    button.addEventListener('click', () => {
      const card = button.closest('.product-card');
      const img = card?.querySelector('.shot') as HTMLImageElement;
      
      if (!card || !img) return;

      // 2. Parse the available keys for this specific product card (e.g., ['F', 'B'])
      const keys = card.dataset.availableKeys?.split(',') || [];
      if (keys.length <= 1) return;

      // 3. Track the letter index alignment
      const currentKey = img.dataset.key || 'F';
      let numericIndex = keys.indexOf(currentKey);
      if (numericIndex === -1) numericIndex = 0;

      // 4. Cycle through your numeric placements
      const direction = button.dataset.action;
      if (direction === 'flip-right') {
        numericIndex = (numericIndex + 1) % keys.length;
      } else if (direction === 'flip-left') {
        numericIndex = (numericIndex - 1 + keys.length) % keys.length;
      }

      const nextKey = keys[numericIndex];

      // 5. Look up the optimized bundle path directly out of Vite's asset tracking map
      // This matches the exact compiled asset string reference that Astro generates!
      const targetImageMeta = allOptimizedImages[nextKey] as any;
      const nextSrc = targetImageMeta?.src || targetImageMeta;

      if (nextSrc) {
        img.src = nextSrc;
        img.dataset.key = nextKey;
      }
    });
  });
</script>