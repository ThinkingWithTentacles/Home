---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

import Layouts from '/src/layouts/Layout.astro';

import ContactForm from '/src/components/ContactForm.astro';
import ReturnTo from '/src/components/ReturnTo.astro';
import ZoomDoom from '/src/components/ZoomDoom.astro';

import SampleGrid from '/src/components/SampleGrid.astro';
import ProductGrid from '/src/components/ProductGrid.astro';
import LightBox from '/src/components/LightBox.astro';
import ProductLabel from '/src/components/ProductLabel.astro';

import { wallpapers } from '/src/data/resource.ts';
import { pages } from '/src/data/resource.ts';
import { icons } from '/src/data/resource.ts';

import { swampWood } from '/src/data/swamp.ts';

import '/src/styles/global.css';
import '/src/styles/woodcraft-page.css';

const wallpaper = wallpapers.wood.bark;
const red = wallpapers.wood.treebark;
const samples = icons.sample;
---

<Layouts title="Thinking With Tentacles">
  <LightBox />
  <ReturnTo destination="swamp" />
  
  <div class="swamp-page-wrapper">
    <div
      id="background"
      class="product-page-background" 
      style={`background-image: url(${wallpaper.src})`}
    ></div>
    
    <ZoomDoom maxZoom={3} minZoom={1}>
      <main>
          <section class="woodcraft-sign" style={`background-image: url(${red.src})`}>
            <h1>Woodcraft</h1>
          </section>

          <SampleGrid samples={Object.values(samples).slice(0, 10)} />
          <SampleGrid samples={Object.values(samples).slice(10, 20)} />

          <section class="woodcraft-info">
            <h1> "Free Samples" </h1>

            <p> Available Stock: Ash, White Maple, Cherry, Mahagony, Walnut, Black Limba, Canary, Yellowheart, Padauk, Purpleheart </p>
            <br>
            <p> Crafting hardwood fancies that are personable, functional, and delightfully your exact type of wood. Offering the art of intentional rule breaking in creating love it for life keepsakes, containers, keepers, cutting boards, and multifunctional charcuterie boards. Paddles too. And maybe eventually a place for you to sit still and relax. </p>
            <p> Current stock below represents designs completely mendable to your desires for personalization and creativity. Reach out if anything sparks an interest. </p>
            <br>
            <p> Or to say anything on your mind really. </p>
          </section>

          <ContactForm />

          <ProductLabel text="Cutting Boards" location="swamp"/>
          <ProductGrid products={Object.values(swampWood.tame)} />

          <ProductLabel text="Hot Boxes" location="swamp"/>
          <ProductGrid products={Object.values(swampWood.hot)} />

          <ProductLabel text="Custom Made Paddle Designs" location="swamp"/>
          <ProductGrid products={Object.values(swampWood.spicy)} />
        </main>
    </ZoomDoom>
  </div>
</Layouts>