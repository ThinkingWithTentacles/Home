---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

import { wallpapers } from '/src/data/wallpaper.ts';
import { grove } from '/src/data/wicked.ts';

import '/src/styles/global.css';
import '/src/styles/swamp-page.css';

import { 
  swampGlass, 
  swampLeather, 
  swampParacord, 
  swampWood, 
  swampWorkshop, 
} from '../../config.js';

const wallpaper = wallpapers.garden[1];
---

<body>
  <div
    id="background"
    class="swamp-background"
    style={`background-image: url(${wallpaper.image.src})`}>
  </div>

  <main>
    <article class="swamp-wrapper">
      <button onclick={`window.location.href = "${swampWood}"`}></button>
      <button onclick={`window.location.href = "${swampLeather}"`}></button>
      <button onclick={`window.location.href = "${swampWorkshop}"`}></button>
    </article>
  </main>
</body>