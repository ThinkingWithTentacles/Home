---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

import { wallpapers } from '/src/data/resource.ts';
import { swamp } from '/src/data/swamp.ts';
import { shop} from '/src/data/swamp.ts';

import SampleGrid from '/src/components/SampleGrid.astro';
import ProductGrid from '/src/components/ProductGrid.astro';
import LightBox from '/src/components/LightBox.astro';
import ContactForm from '/src/components/ContactForm.astro';
import SocialLinks from '/src/components/SwampSocialLinks.astro';

import '/src/styles/global.css';
import '/src/styles/workshop-page.css';

const wallpaper = wallpapers.woodcraft[2];
const me = shop.deleted.me[0].image;
---

<body
  id="background"
  class="product-page-background"
  style={`background-image: url(${wallpaper.image.src})`}
>

<main>
    <section class="shop-sign">
      <h1>Hey</h1>
    </section>

    <section class="shop-info">
      <h1>So</h1>

      <p>Iunno </p>
      
      <p> About that </p>
    </section>

    <SocialLinks />

    <Image src= {me} alt= "OKAY"/>
  </main>
</body> 







