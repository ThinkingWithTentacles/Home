---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

import Layouts from '/src/layouts/Layout.astro';

import ReturnTo from '/src/components/ReturnTo.astro';
import ZoomDoom from '/src/components/ZoomDoom.astro';

import { wallpapers } from '/src/data/resource.ts';
import { swamp } from '/src/data/swamp.ts';

import receipts from "/src/assets/Resources/credits.json"

import '/src/styles/global.css';
import '/src/styles/swamp-page.css';

import { 
  swampGlass, 
  swampLeather, 
  swampParacord, 
  swampWood, 
  swampWorkshop, 
} from '../../config.js';

{console.log(wallpapers)}

const wallpaper = wallpapers.thinking.think;
const background = wallpapers.thinking.thunk;
---

<Layouts title="Thinking With Tentacles">
  <ReturnTo destination="home" />
  <div class="swamp-page-wrapper">
    <div 
      class="swamp-page-background" 
      style={`background-image: url(${wallpaper.src})`}
    ></div>
    <ZoomDoom maxZoom={3} minZoom={1}>
      <main>
        <section class="swamp-sign">
          <div class="sign-halo-plate"></div>
          <h1>Thinking With Tentacles</h1>
        </section>

        <div class="tentacle-wrapper">
          <Image src={background} alt="" />

          <a class="thinking-grotto" href={swampWood}>
            <div class="thinking-halo-plate"></div>
            <span class="thinking-text">Woodcraft</span>
          </a>

          <a class="pondering-grotto" href={}>
            <div class="pondering-halo-plate"></div>
            <span class="pondering-text">Leathercraft</span>
            <span class="soon-text">Soon...</span>
          </a>

          <a class="swampshop-grotto" href={swampWorkshop} >
            <div class="swampshop-halo-plate"></div>
            <span class="swampshop-text">Swampshop</span>
          </a>

          <a class="tentacular-grotto" href={receipts.tentacular} target="_blank" rel="noopener noreferrer">
            <div class="tentacular-halo-plate"></div>
            <span class="tentacular-text">Conception of Craving</span>
          </a>

          <a class="checkout-card" href={receipts.thinking} target="_blank" rel="noopener noreferrer">
            <div class="checkout-halo-plate"></div>
          </a>

           <div class="swamp-zone">
            <section class="swamp-info">
              <p>Welcome dear sea polyp</p>
              <p>To the domain where tentacular thinking translates inertia in the direction the body wants to flow.</p>
              <p>There is a sensation within our depths yearning to be felt.</p>
              <p>There is a yearning within my depths to create the object of that desire.</p>
              <p>Personality expressive, hand loved, and fully functional hardwood and leather crafts.</p>
              <p>There is more going on here than meets the eye. This is a place where I think out loud as I craft, in pursuit of the tradition of preserving mythical wisdom and personal follies.</p>
              <p>And maybe figure out how to be human.</p>
              <p>I implore you to explore, share inspiration, or reach out if anything grabs your attention and deserves a personal transformation.</p>
              <p>There will always be more.</p>
            </section>
          </div>
        </div>
      </main>
    </ZoomDoom>
  </div>
</Layouts>