---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

import Layouts from '/src/layouts/Layout.astro';

import ReturnTo from '/src/components/ReturnTo.astro';
import ZoomDoom from '/src/components/ZoomDoom.astro';

import { wallpapers } from '/src/data/resource.ts';
import { vault } from '/src/data/vault.ts';
import { archive } from '/src/data/vault.ts';

import SampleGrid from '/src/components/SampleGrid.astro';
import ProductGrid from '/src/components/ProductGrid.astro';
import LightBox from '/src/components/LightBox.astro';
import ContactForm from '/src/components/ContactForm.astro';
import ProductLabel from '/src/components/ProductLabel.astro';

import '/src/styles/global.css';
import '/src/styles/vault-page.css';

import { 
  duck,
} from '../../config.js';

const wallpaper = wallpapers.woodcraft[1];
---

<Layouts title="The Vault of Stuff">
  <LightBox />
  <ReturnTo destination="home" />
  
  <div class="product-page-wrapper">
    <div
      class="product-page-background" 
      style={`background-image: url(${wallpaper.image.src})`}
    ></div>

      <ZoomDoom maxZoom={3} minZoom={1}>
        <main>

        <section class="vault-sign">
          <h1>Stay</h1>
        </section>

        <ProductLabel text="Prototype and Commissionable Concepts" location="vault"/>
        <ProductGrid products={Object.values(archive.shelf)} />

        <ProductLabel text="Sold!" />
        <ProductGrid products={Object.values(archive.pushed)} location="vault"/>
        <ContactForm />

        <br>
        <br>
        <br>
        <br>
        <br>
        <br>
        <br>
        <br>
        <br>
        <br>
        <br>
        <br>
        <br>
        <br>
        <br>
        <br>
        <br>

        <a href={duck}>|   Duckprints   |</a>
      </main>    
    </ZoomDoom>
  </div>
</Layouts>