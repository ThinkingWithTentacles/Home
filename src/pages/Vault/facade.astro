---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

import Layouts from '/src/layouts/Layout.astro';

import ReturnTo from '/src/components/ReturnTo.astro';
import ZoomDoom from '/src/components/ZoomDoom.astro';

import { wallpapers } from '/src/data/resource.ts';
import { vault } from '/src/data/vault.ts';
import { creations } from '/src/data/vault.ts';
import { pushed } from '/src/data/vault.ts';

import SampleGrid from '/src/components/SampleGrid.astro';
import ProductGrid from '/src/components/ProductGrid.astro';
import LightBox from '/src/components/LightBox.astro';
import ContactForm from '/src/components/ContactForm.astro';
import ProductLabel from '/src/components/ProductLabel.astro';

import '/src/styles/global.css';
import '/src/styles/vault-page.css';

import { 
  duck,
} from '../../config.js';

const flowers = creations.wicked;
const constructs = creations.swamp;
const sold = pushed;

const wallpaper = wallpapers.wood.redbark;
---

<Layouts title="The Vault of Stuff">
  <LightBox />
  <ReturnTo destination="home" />
  
  <div class="product-page-wrapper">
    <div
      class="product-page-background" 
      style={`background-image: url(${wallpaper.src})`}
    ></div>

      <ZoomDoom maxZoom={3} minZoom={1}>
        <main>

        <section class="vault-sign">
          <h1>Stay</h1>
        </section>

        <section class="vault-header">
          <p> A vault of creations that achieved the coveted "finished" merit badge and those that found a home. Designs and concepts are commisionable and custimizable.</p>
        </section>

        <ContactForm />

        <ProductLabel text="Wicked Creations" location="vault"/>
        <ProductGrid products={Object.values(flowers)} />

        <ProductLabel text="Swamp Constructs and Prototypes" location="vault"/>
        <ProductGrid products={Object.values(constructs)} />

        <ProductLabel text="Sold!" />
        <ProductGrid products={Object.values(pushed)} location="vault"/>

        <br>
        <br>
        <br>
        <br>
        <br>
        <br>
        <br>
        <br>
        <br>
        <br>
        <br>
        <br>
        <br>
        <br>
        <br>
        <br>
        <br>

        <a href={duck}>|   Duckprints   |</a>
      </main>    
    </ZoomDoom>
  </div>
</Layouts>