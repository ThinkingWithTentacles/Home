---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

import Layouts from '/src/layouts/Layout.astro';

import { wallpapers } from '/src/data/resource.ts';
import { wickedWireArt } from '/src/data/wicked.ts';
import { wickedWires } from '/src/data/wicked.ts';

import ProductGrid from '/src/components/ProductGrid.astro';
import LightBox from '/src/components/LightBox.astro';

import ReturnTo from '/src/components/ReturnTo.astro';
import ContactForm from '/src/components/ContactForm.astro';
import ProductLabel from '/src/components/ProductLabel.astro';
import ZoomDoom from '/src/components/ZoomDoom.astro';

import '/src/styles/global.css';
import '/src/styles/wire-art-page.css';

const wallpaper = wallpapers.garden[0];
---

<Layouts title="Wicked Wires">
  <div class="product-page-wrapper">
    <div 
      class="product-page-background" 
      style={`background-image: url(${wallpaper.image.src})`}
    ></div>

    <ReturnTo destination= "garden" />

    <ZoomDoom maxZoom={3} minZoom={1}>
      <main>
        <section class="garden-sign">
          <h1>Wire Art</h1>
        </section>

        <section class="garden-info">
          <p> Where my journey with handmade art began. There's something special about working with wire by hand-shaping it slowly around stones, crystals, and
              found treasures until something entirely new takes form. Each piece is an exploration of texture, movement, and the natural beauty of the materials themselves.
          </p>

          <p> I'm not currently creating new wire-wrapped pieces for the collection, but I still welcome custom requests. Have a stone, crystal, or idea you'd love to see transformed?
              Email me with your vision, and let's create something uniquely yours.
          </p>
        </section>

        <ContactForm />

        <ProductLabel text="Whimsical Treasures"  location="garden"/>
        <ProductGrid products={Object.values(wickedWires.broom)}/>

        <ProductLabel text="Blunt Grabbers and Holders"  location="garden"/>
        <ProductGrid products={Object.values(wickedWires.blunt)} />
        <LightBox />
      </main>
    </ZoomDoom>
  </div>
</Layouts>