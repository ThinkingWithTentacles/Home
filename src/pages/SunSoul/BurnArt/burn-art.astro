---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

import { wallpapers } from '/src/data/resource.ts';
import { wickedBurnArt } from '/src/data/wicked.ts';
import { wickedBurns } from '/src/data/wicked.ts';

import ProductGrid from '/src/components/ProductGrid.astro';
import LightBox from '/src/components/LightBox.astro';
import ContactForm from '/src/components/ContactForm.astro';

import '/src/styles/global.css';
import '/src/styles/burn-art-page.css';

const wallpaper = wallpapers.garden[0];
---

<body
  id="background"
  class="product-page-background"
  style={`background-image: url(${wallpaper.image.src})`}
>

<main>
    <section id="burning-art" class="garden-sign">
      <h1>Burning Art</h1>
    </section>

    <section class="burning-info">
      <p> Burning tarot cards, animals, titles, signs, and wholesome smut </p>
      
      <p> Wood burning is one of the many ways I love to turn an idea into something tangible. I'm drawn
           to the natural character of wood and the patience of creating each image through heat,
           texture, and detail.</p>

      <p>I'm not currently creating new wood-burned pieces for the collection, but custom requests are
          still welcome. Have an idea in mind? Email me with your vision, and let's talk about bringing
          it to life on wood. </p>
    </section>

    <ContactForm />

    <ProductGrid products={Object.values(wickedBurns.tame)} />
    <ProductGrid products={Object.values(wickedBurns.tarot)} />
    <ProductGrid products={Object.values(wickedBurns.spicy)} />
    <LightBox />
  </main>
</body> 