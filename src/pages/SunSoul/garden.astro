---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

import Layouts from '/src/layouts/Layout.astro';

import ReturnTo from '/src/components/ReturnTo.astro';
import ZoomDoom from '/src/components/ZoomDoom.astro';
import SocialLinks from '/src/components/SocialLinks.astro';

import { wallpapers } from '/src/data/resource.ts';
import { pages } from '/src/data/resource.ts';

import '/src/styles/global.css';
import '/src/styles/garden-page.css';

import { 
  wickedBurn, 
  wickedDye, 
  wickedWire, 
  wickedArtStudio,
} from '../../config.js';

const wallpaper = wallpapers.galaxy.garden;
const sunSoul = pages.wicked.sunsoul;
---

<Layouts title="SunSoul Studio">
  <ReturnTo destination="home" />
    <div class="garden-page-wrapper">
      <div 
        class="garden-page-background" 
        style={`background-image: url(${wallpaper.src})`}
      ></div>
      <ZoomDoom maxZoom={3} minZoom={1}>
      <main>

        <section class="ring-wrapper">
          <Image src={sunSoul} alt="" />

          <a class="burn-grotto" href={wickedBurn}>
            <div class="burn-halo-plate"></div>
            <span class="burn-text">Wicked Burns</span>
          </a>

          <a class="dye-grotto" href={wickedDye}>
            <div class="dye-halo-plate"></div>
            <span class="dye-text">Wicked Dyes</span>
          </a>

          <a class="wire-grotto" href={wickedWire}>
            <div class="wire-halo-plate"></div>
            <span class="wire-text">Wicked Wires</span>
          </a>
        </section>

        <section class="garden-sign">
          <h1>SunSoul Studios</h1>
        </section>

        <section class="garden-info">
          <p> A flare of solar light casts rays of color upon whimsical fancies, scorched wood, and reclaimed clothing. </p>
          <p> Let me add a spark of charm to your life in creating something uniquely yours. </p>
          <p> You'll find I put most of my effort into upcycling natural fiber clothing, blanket tapestries, and anything worthwhile with evolving ice dye techniques. </p>
          <p> Otherwise I add sets of wood burnings ranging from tame to spicy and wire wrappings from past projects. Examples of my previous business and/or lifestyle logo designs are kept in the vault with all the reclaimed treasures. </p>
        </section>

        <SocialLinks source="garden"/>
      </main>
     </ZoomDoom>
  </div>
</Layouts>