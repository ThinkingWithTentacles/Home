---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

import { wallpapers } from '/src/data/resource.ts';
import { garden } from '/src/data/wicked.ts';

import '/src/styles/global.css';
import '/src/styles/garden-page.css';

import { 
  wickedBurn, 
  wickedDye, 
  wickedWire, 
  wickedArtStudio,
} from '../../config.js';

{console.log(wallpapers)}

const wallpaper = wallpapers.garden[0];
const hyperRing = garden.ring[0];
---

<body
  id="background"
  class="landing-page-background"
  style={`background-image: url(${wallpaper.image.src})`}
>
  <main>
    <article class="ring-wrapper">
      <Image src={hyperRing.image} alt="Sample"/>

      <button class="studio-wrapper" onclick={`window.location.href = "${wickedArtStudio}"`}></button>
      <button class="burn-wrapper" onclick={`window.location.href = "${wickedDye}"`}></button>
      <button class="dye-wrapper" onclick={`window.location.href = "${wickedWire}"`}></button>
      <button class="wire-wrapper" onclick={`window.location.href = "${wickedBurn}"`}></button>
    </article>
  </main>
</body>