---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

import Layouts from '/src/layouts/Layout.astro';

import { wallpapers } from '/src/data/resource.ts';
import { wickedDyeArt } from '/src/data/wicked.ts';
import { wickedDyes } from '/src/data/wicked.ts';

import ProductGrid from '/src/components/ProductGrid.astro';
import LightBox from '/src/components/LightBox.astro';

import ReturnTo from '/src/components/ReturnTo.astro';
import ContactForm from '/src/components/ContactForm.astro';
import ProductLabel from '/src/components/ProductLabel.astro';
import ZoomDoom from '/src/components/ZoomDoom.astro';

import '/src/styles/global.css';
import '/src/styles/dye-art-page.css';

const wallpaper = wallpapers.garden[0];
---

<Layouts title="Wicked Dyes">
  <div class="product-page-wrapper">
    <div 
      class="product-page-background" 
      style={`background-image: url(${wallpaper.image.src})`}
    ></div>

    <ZoomDoom maxZoom={3} minZoom={1}>
      <main>
        <ReturnTo destination= "garden" />

        <section class="garden-sign">
          <h1>Dying Art</h1>
        </section>

        <section class="garden-info">
          <p> Upcycled natural fiber clothing, blank tapestries, thrifted gems reimagined in color </p>
          
          <p> Each piece is individually hand-dyed with Dharma ice dye, giving new life to pre-loved clothing and turning it
              into something completely unique. No two pieces will ever be exactly alike. It's all part of the magic.
          </p>

          <p> No holds bar on type of clothing, creations are always finding their way into the studio, so check back often to see what's
              blooming in color.
          </p>

          <p> Have an idea of your own or want us to tweak a design for you? Custom requests are welcome. Email us with your vision, and
              let's create something together.
          </p>
        </section>

        <ContactForm />

        <ProductLabel text="Tapestries and Pillow Cases" location="garden"/>
        <ProductGrid products={Object.values(wickedDyes.tapes)} />

        <ProductLabel text="Dresses"  location="garden"/>
        <ProductGrid products={Object.values(wickedDyes.dresses)}/>

        <ProductLabel text="Shirts and Tops"  location="garden"/>
        <ProductGrid products={Object.values(wickedDyes.shirts)}/>

        <ProductLabel text="Shorts and Skirts"  location="garden"/>
        <ProductGrid products={Object.values(wickedDyes.shorts)}/>

        <ProductLabel text="Kids Sizes"  location="garden"/>
        <ProductGrid products={Object.values(wickedDyes.kids)}/>
        <LightBox />
      </main>
    </ZoomDoom>
  </div>
</Layouts>