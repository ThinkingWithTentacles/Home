---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

import { wallpapers } from '/src/data/resource.ts';
import { wickedDyeArt } from '/src/data/wicked.ts';
import { wickedDyes } from '/src/data/wicked.ts';

import ProductGrid from '/src/components/ProductGrid.astro';
import LightBox from '/src/components/LightBox.astro';

import '/src/styles/global.css';
import '/src/styles/dye-art-page.css';

const wallpaper = wallpapers.garden[0];
---

<body
  id="background"
  class="product-page-background"
  style={`background-image: url(${wallpaper.image.src})`}
>

<main>
    <section id="dying-art" class="dying-sign">
      <h1>Dying Art</h1>
    </section>

    <section class="dying-info">
      <h1>dye</h1>

      <p> Thrifted pieces and blank tapestries, reimagined in color </p>
      
      <p> Each piece is individually hand-dyed, giving new life to pre-loved clothing and turning it
           into something completely unique. No two pieces will ever be exactly alike—and that's part
           of the magic.
      </p>

      <p> New creations are always finding their way into the studio, so check back often to see what's
           blooming in color.
      </p>

      <p> Have an idea of your own? Custom requests are welcome. Email us with your vision, and
           let's create something together.
      </p>
    </section>

    <ProductGrid products={Object.values(wickedDyes.tapes)} />
    <ProductGrid products={Object.values(wickedDyes.dresses)} />
    <ProductGrid products={Object.values(wickedDyes.shirts)} />
    <ProductGrid products={Object.values(wickedDyes.shorts)} />
    <ProductGrid products={Object.values(wickedDyes.kids)} />
    <LightBox />
  </main>
</body> 