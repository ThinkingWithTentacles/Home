---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

import Layouts from '/src/layouts/Layout.astro';

import ReturnTo from '/src/components/ReturnTo.astro';
import ZoomDoom from '/src/components/ZoomDoom.astro';

import { wallpapers } from '/src/data/resource.ts';
import { deadend } from '/src/data/deadend.ts';
import { ends } from '/src/data/deadend.ts';

import '/src/styles/global.css';
import '/src/styles/dead-end-page.css';

const wallpaper = wallpapers.galaxy.dust;
---

<Layouts title="The End">
  <ReturnTo destination="home" />
  
  <div class="swamp-page-wrapper">
    <div
      class="swamp-page-background" 
      style={`background-image: url(${wallpaper.src})`}
    ></div>

    <ZoomDoom maxZoom={3} minZoom={1}>
        <main>
          <section class="dead-end-sign">
            <h1>Dead End</h1>
          </section>

          <section class="dead-end-header">
            <p>Coming Soon: Stuff</p>
          </section>

          <section class="dead-end-info">
            <p>What is stuff?</p>
            <p>How can I get stuff?</p>
            <p>What stuff do I need?</p>
            <p>Do I need stuff to get stuff?</p>
            <p>What if I have too much stuff?</p>
            <p>Where does all this stuff go?</p>
          </section>
        </main>    
    </ZoomDoom>
  </div>
</Layouts>