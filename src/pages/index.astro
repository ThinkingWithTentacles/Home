---
import { wallpapers } from '/src/data/resource.ts';

import { 
  swampGrove, 
  wickedGrove, 
  deadEnd,
  theVault
} from '../config.js';

import '/src/styles/global.css';
import '/src/styles/home-page.css';

const wallpaper = wallpapers.landing[0];
---

<body
  id="background"
  class="home-page-background"
  style={`background-image: url(${wallpaper.image.src})`}
>
  <main>
    <section class="home-sign">
      <h1>Woodcraft</h1>
    </section>

    <a href={swampGrove}>|   Thinking With Tentacles   |</a>;
    <a href={wickedGrove}>|   WickedGabi   |</a>;
    <a href={deadEnd}>|   Dead End   |</a>;
  </main>
</body>
