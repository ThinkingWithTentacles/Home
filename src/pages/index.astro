---
import { Image } from 'astro:assets';

import Layouts from '/src/layouts/Layout.astro';

import DenTracker from '/src/components/DenTracker.astro';
import ZoomDoom from '../components/ZoomDoom.astro';

import { wallpapers } from '/src/data/resource.ts';
import { pages } from '/src/data/resource.ts';

import receipts from "/src/assets/Resources/credits.json"

import { 
  swampGrove, 
  wickedGrove, 
  deadEnd,
  theVault
} from '../config.js';

import '/src/styles/global.css';
import '/src/styles/home-page.css';

const wallpaper = wallpapers.landing.abyss;
const riverHavenGrotto = pages.home.banner;

const sunsoul = pages.wicked.sunsoul;
const swampthing = pages.swamp.thinking;
const deadend = pages.home.deadend;
const vault = pages.home.shed;

interface Props {
  den: number;
}

const { den } = Astro.props;

const words = ["exists", "implores", "decays", "absolves", "breathes", "spreads", "says yes", "thinks", "infuses", "loves you", "laughs", "cries", 
 "is hand loved", "dies", "dyes", "slaps", "burns", "wraps", "feels", "holds", "hits", "takes a hit", "is a hit", "needs you",
 "has been", "will be", "drops", "finds you", "waits", "evolves", "grows", "consumes", "is free", "ducks","fucks", "lives patiently for you"];
 ---

<Layouts title="River Haven Grotto">
  <div class="home-page-wrapper">
    <div 
      class="home-page-background" 
      style={`background-image: url(${wallpaper.src})`}
    ></div>
    
    <ZoomDoom maxZoom={3} minZoom={1}>
      <main>
        <section class="home-sign">
          <a href={receipts.home} target="_blank" rel="noopener noreferrer">
          <Image src={riverHavenGrotto} alt="River Haven Grotto Banner" class="home-banner" />
          </a>
          
          <span class="home-name">River Haven Grotto</span>
          <span class="home-callout" data-words={JSON.stringify(words)}>Where art lives patiently for you</span>
        </section>

        <section class="home-header">
          <p> Welcome. </p>
        </section>

        <section class="home-info">      
          <p> River Haven Grotto is a landing page for the artist in everyone, including you. </p>

          <p> A place for sharing passion projects, points of contact, and galleries of creations in a way that becomes part of the joy that drives creativity. An online street market where each hub contains hand loved goods to wander through and stumble upon. Where the desire to manifest a dream coexists with the dream to manifest a desire.</p>

          <p> What you see now may not be what remains upon your return. By owning the code, deployment, and domain, River Haven Grotto is being built to pass the tools of success forward. The site aims to evolve as a resource for lifestyle hobbyists and commission style artists who desire a personalized grove of their craft to exist and share. A shared pursuit to make such barriers limited by creativity, not subscription triangles.</p>

          <p> This site was painted together with imagination and hand loved code. Enjoy your stay, come back soon, be present. The river is deeper than it appears, but every grotto is a haven of information. </p>
        </section>

        <DenTracker />

        <section class="grove-container">
          <div class="grove-top">
            <a class="soul-grotto" href={wickedGrove}> 
              <Image src={sunsoul} alt="SunSoul" /> 
              <div class="soul-halo-plate"></div> 
            </a>

            <a class="swamp-grotto" href={swampGrove}> 
              <Image src={swampthing} alt="Dead End" /> 
              <div class="swamp-halo-plate" ></div> 
              <span class="swamp-text">Thinking With Tentacles</span> 
            </a>
          </div>

          <a class="vault-grotto" href={theVault}> 
            <Image src={vault} alt="The Vault" /> 
            <div class="vault-halo-plate"></div> 
            <span class="vault-text">Vault</span> 
          </a>

          <a class="dead-grotto" href={deadEnd}> 
            <Image src={deadend} alt="Dead End" /> 
            <div class="dead-halo-plate" style={`--shadow-x: ${den}dvw;`}></div> 
            <span class="dead-text">Dead End</span> 
          </a>
        </section>

        <section class="gradient-background" >
        </section>
      </main>
    </ZoomDoom>
  </div>
</Layouts>

<script>
  const span = document.querySelector('.home-callout');

  if (span) {
    const words = JSON.parse(span.getAttribute('data-words') || '[]');
    let wordIndex = 0;

    function updateWord() {
      const  word = words[wordIndex];
      span.textContent = "Where art " + word;

      let nextDelay = 1000; // Default fallback delay

      if (word === "lives patiently for you") {
        nextDelay = 3500;
      } else {
        nextDelay = 3500/(0.4*wordIndex+1);
      }

      setTimeout(updateWord, nextDelay);

      wordIndex = (wordIndex + 1) % words.length;
    }

    setTimeout(updateWord, 3500);
  }
</script>