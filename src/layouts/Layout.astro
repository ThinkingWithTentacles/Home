---
const { title = "Default Title" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

	<link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
  </head>
  <body>
    <slot />

	<script>
		const zones = document.querySelectorAll('[class$="-zone"]');

		zones.forEach(zone => {
			zone.addEventListener('click', function() {
			zones.forEach(otherZone => {
				if (otherZone !== this) {
				otherZone.classList.remove('touch-active');
				}
			});

			this.classList.toggle('touch-active');
			});
		});
	</script>

	<script>
	function initializeBurnEffects() {
		const links = document.querySelectorAll('[class$="-grotto"]');
		
		links.forEach(link => {
		if (link.dataset.burnEffectsInitialized) return;
		link.dataset.burnEffectsInitialized = "true";

		link.addEventListener('click', function (event) {
			event.preventDefault();
			const targetUrl = this.href;
			
			this.classList.add('touch-active');

			const isExternal = this.hostname !== window.location.hostname;
			const isBlankTarget = this.target === '_blank';
			const isNewTab = isExternal || isBlankTarget;

			let delayTime = 1000; // Default fallback

			const textChild = this.querySelector('[class$="-text"]');
			
			if (textChild) {
			const computedStyle = window.getComputedStyle(textChild);
			
			if (computedStyle.transitionDuration && computedStyle.transitionDuration !== '0s') {
				const durations = computedStyle.transitionDuration.split(', ');
				const delays = computedStyle.transitionDelay.split(', ');

				let maxTotalTime = 0;
				durations.forEach((duration, index) => {
				const parsedDuration = parseFloat(duration) * (duration.includes('ms') ? 1 : 1000);
				const parsedDelay = delays[index] ? parseFloat(delays[index]) * (delays[index].includes('ms') ? 1 : 1000) : 0;
				
				const totalTime = parsedDuration + parsedDelay;
				if (totalTime > maxTotalTime) {
					maxTotalTime = totalTime;
				}
				});

				if (maxTotalTime > 0) {
				delayTime = maxTotalTime;
				}
			}
			}

			setTimeout(() => {
			if (isNewTab) {
				window.open(targetUrl, '_blank');
				this.classList.remove('touch-active');
			} else {
				window.location.href = targetUrl;
			}
			}, delayTime);
		});
		});
	}

	initializeBurnEffects();

	document.addEventListener('astro:page-load', initializeBurnEffects);

	window.addEventListener('pageshow', (event) => {
		if (event.persisted) {
			document.querySelectorAll('[class*="-grotto"].touch-active, [class*="-zone"].touch-active')
				.forEach(el => el.classList.remove('touch-active'));

			if (document.activeElement instanceof HTMLElement) {
				document.activeElement.blur();
			}
		}
	});
	</script>
  </body>
</html>

<style is:global>
  html, body {
    min-height: 100%; 
    height: auto;
  }
</style>