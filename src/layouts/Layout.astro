---
// Frontmatter can accept props like a dynamic page title
const { title = "Default Title" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

	<link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
  </head>
  <body>
    <slot />

    <script>
		function initializeBurnEffects() {
		const links = document.querySelectorAll('[class$="-grotto"]');
		
		links.forEach(link => {
			link.addEventListener('click', function (event) {
				const anchor = link.closest('a');
				event.preventDefault();
				const targetUrl = this.href;
				
				this.classList.add('touch-active');

				// 2. Query the text child element which holds the longest transition definitions
				const textChild = link.querySelector('[class$="-text"]'); // Matches .vault-text, .dead-text, etc.
				
				if (textChild) {
				const computedStyle = window.getComputedStyle(textChild);
				
				// Extract transition duration and delay strings (e.g., "1s", "0.05s" or "1000ms")
				const durations = computedStyle.transitionDuration.split(', ');
				const delays = computedStyle.transitionDelay.split(', ');

				// Parse times into milliseconds and calculate the maximum total duration
				let maxTotalTime = 0;
				durations.forEach((duration, index) => {
					const parsedDuration = parseFloat(duration) * (duration.includes('ms') ? 1 : 1000);
					const parsedDelay = delays[index] ? parseFloat(delays[index]) * (delays[index].includes('ms') ? 1 : 1000) : 0;
					
					const totalTime = parsedDuration + parsedDelay;
					if (totalTime > maxTotalTime) {
					maxTotalTime = totalTime;
					}
				});

				// 3. Navigate precisely when the longest transition completes
				setTimeout(() => {
					window.location.href = targetUrl;
				}, maxTotalTime);
				
				} else {
				// Fallback if no specific animated child text block is found
				setTimeout(() => {
					window.location.href = targetUrl;
				}, 1000);
				}
			});
		});
		}

		initializeBurnEffects();

		window.addEventListener('pageshow', (event) => {
		if (event.persisted) {
			const activegrottos = document.querySelectorAll(
			'.burn-grotto.touch-active, .wire-grotto.touch-active, .dye-grotto.touch-active, .dead-grotto.touch-active, .vault-grotto.touch-active, .swamp-grotto.touch-active, .soul-grotto.touch-active'
			);
			
			activegrottos.forEach(grotto => {
			grotto.classList.remove('touch-active');
			});

			if (document.activeElement instanceof HTMLElement) {
			document.activeElement.blur();
			}
		}
		});
	</script>
  </body>
</html>

<style is:global>
  html, body {
    min-height: 100%; 
    height: auto;
  }
</style>