---
// Frontmatter can accept props like a dynamic page title
const { title = "Default Title" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

	<link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
  </head>
  <body>
    <slot />

    <script>
		function initializeBurnEffects() {
		// Combine all selectors into a single NodeList
		const links = document.querySelectorAll('.burn-wrapper, .wire-wrapper, .dye-wrapper, .dead-wrapper');
		
		links.forEach(link => {
			link.addEventListener('click', function (event) {
			const anchor = link.closest('a');
			if (!anchor) return;

			event.preventDefault();
			
			link.classList.add('touch-active');
			const targetUrl = anchor.href;

			setTimeout(() => {
				window.location.href = targetUrl;
			}, 1000);
			});
		});
		}

		initializeBurnEffects();

		window.addEventListener('pageshow', (event) => {
		if (event.persisted) {
			// Select and clean up all touch-active wrapper elements at once
			const activeWrappers = document.querySelectorAll(
			'.burn-wrapper.touch-active, .wire-wrapper.touch-active, .dye-wrapper.touch-active, .dead-wrapper.touch-active'
			);
			
			activeWrappers.forEach(wrapper => {
			wrapper.classList.remove('touch-active');
			});

			// Remove focus from the currently active element
			if (document.activeElement instanceof HTMLElement) {
			document.activeElement.blur();
			}
		}
		});
	</script>
  </body>
</html>

<style is:global>
  html, body {
    min-height: 100%; 
    height: auto;
  }
</style>